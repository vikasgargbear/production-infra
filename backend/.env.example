# Runtime mode
APP_ENV=development

# Database connection (required in production)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Supabase Auth
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
# Backend-only; required only by admin user-management operations
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# ERP access-token signing (required in production; distinct from Supabase keys)
JWT_SECRET_KEY=[YOUR-JWT-SECRET]

# Browser origin allowlist, encoded as JSON or a comma-separated list
CORS_ORIGINS=http://localhost:3000

# Optional email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
