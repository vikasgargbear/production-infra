# Runtime mode
APP_ENV=development

# Runtime database connection. Canonical production must authenticate as the
# non-owner, non-superuser, non-BYPASSRLS erp_runtime role.
DATABASE_URL=postgresql://erp_runtime:[YOUR-RUNTIME-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Dedicated calculation authority credential. It must authenticate as the
# zero-table-privilege erp_calculator role and is never shared with MCP/frontend.
ERP_CALCULATOR_DATABASE_URL=postgresql://erp_calculator:[YOUR-CALCULATOR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Isolated tax-provider command credential and worker authentication. These
# three values are backend-only, mutually distinct, and remain unused until the
# code-owned promotion gate is released after external conformance review.
TAX_PROVIDER_DATABASE_URL=postgresql://erp_tax_provider:[YOUR-TAX-PROVIDER-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
TAX_PROVIDER_INTERNAL_SERVICE_TOKEN=[YOUR-TAX-PROVIDER-WORKER-BEARER-SECRET]
TAX_PROVIDER_INTERNAL_HMAC_SECRET=[YOUR-TAX-PROVIDER-WORKER-HMAC-SECRET]

# Supabase Auth
CANONICAL_STAGING_PROJECT_REF=[YOUR-CANONICAL-STAGING-PROJECT-REF]
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# Private canonical evidence storage. Keep disabled until the exact hosted Auth
# service identity, custom access-token hook, and bucket policy are provisioned.
# Never use a project service-role key or a human ERP identity here.
EVIDENCE_STORAGE_ENABLED=false
EVIDENCE_STORAGE_EXPECTED_PROJECT_REF=[YOUR-EVIDENCE-STORAGE-PROJECT-REF]
EVIDENCE_STORAGE_SERVICE_AUTH_USER_ID=[YOUR-REVIEWED-SERVICE-AUTH-UUID]
EVIDENCE_STORAGE_SERVICE_EMAIL=[YOUR-REVIEWED-SERVICE-EMAIL]
EVIDENCE_STORAGE_SERVICE_PASSWORD=[YOUR-ROTATED-SERVICE-PASSWORD]

# ERP access-token signing (required in production; distinct from Supabase keys)
JWT_SECRET_KEY=[YOUR-JWT-SECRET]

# Browser origin allowlist, as a comma-separated list
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# Structured logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Optional email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Pharma ERP

# Optional hosted MCP delegation on the API service. The isolated MCP service
# has its own service-contract.json; use the same token and reviewed client IDs.
MCP_INTERNAL_SERVICE_TOKEN=
MCP_OAUTH_PRE_REGISTERED_CLIENT_IDS=
