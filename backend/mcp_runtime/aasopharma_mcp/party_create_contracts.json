{
  "erp_customer_create": {
    "additionalProperties": false,
    "properties": {
      "address_line1": {
        "anyOf": [
          {
            "maxLength": 255,
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "address_line2": {
        "anyOf": [
          {
            "maxLength": 255,
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "city": {
        "anyOf": [
          {
            "maxLength": 100,
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "contact_person_name": {
        "anyOf": [
          {
            "maxLength": 100,
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "credit_days": {
        "maximum": 365,
        "minimum": 0,
        "type": "integer"
      },
      "credit_limit": {
        "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,4})?$",
        "type": "string"
      },
      "customer_name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "customer_type": {
        "enum": [
          "individual",
          "organization"
        ],
        "type": "string"
      },
      "gst_number": {
        "anyOf": [
          {
            "maxLength": 15,
            "minLength": 15,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$"
      },
      "idempotency_key": {
        "description": "Stable caller key for exact replay of this create request.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
        "type": "string"
      },
      "pan_number": {
        "anyOf": [
          {
            "maxLength": 10,
            "minLength": 10,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$"
      },
      "pincode": {
        "anyOf": [
          {
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "primary_email": {
        "anyOf": [
          {
            "format": "email",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "primary_phone": {
        "pattern": "^\\d{10}$",
        "type": "string"
      },
      "state_code": {
        "anyOf": [
          {
            "pattern": "^[0-9]{2}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "customer_name",
      "customer_type",
      "primary_phone",
      "credit_limit",
      "credit_days",
      "idempotency_key"
    ],
    "type": "object"
  },
  "erp_supplier_create": {
