      "idempotency_key": {
        "description": "Stable caller key for exact replay of this create request.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
        "type": "string"
      },
      "pan_number": {
        "anyOf": [
          {
            "maxLength": 10,
