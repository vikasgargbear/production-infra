    "procurement.goods_receipt.prepare": {"manifest_key": "goods_receipt_pilot_scope", "unsupported_fail_closed": ["fully_rejected_or_free_only_receipt", "H_H1_X_NDPS_or_controlled_product", "import_sez_or_reverse_charge_po", "missing_branch_or_supplier_forms_20B_and_21B"]},
