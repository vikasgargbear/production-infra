    "procurement.supplier_invoice.prepare": {"manifest_key": "supplier_invoice_pilot_scope", "unsupported_fail_closed": ["import", "sez", "reverse_charge", "composition_or_unregistered_supplier", "direct_unreceived_product_lines", "price_variance_or_capitalized_charge", "ineligible_blocked_or_deferred_itc", "withholding"]},
