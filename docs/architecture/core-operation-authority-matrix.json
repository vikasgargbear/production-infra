      "rest_context": ["/api/canonical/returns/supplier-invoices/{invoice_id}/context"],
      "rest_readback": "/api/canonical/returns/purchases/{resource_id}",
      "prepare_sql": "erp_automation_commands.persist_purchase_return_prepare",
