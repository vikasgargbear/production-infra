      "prepare_sql": "erp_automation_commands.persist_sales_invoice_prepare",
      "execute_sql": ["erp_commercial_commands.post_sales_invoice"],
      "authoritative_tables": ["sales.invoices", "sales.invoice_lines", "sales.invoice_dispatch_allocations", "inventory.inventory_documents", "inventory.inventory_document_lines", "inventory.stock_ledger_entries", "inventory.stock_balances", "finance.accounting_events", "finance.journal_entries", "finance.journal_lines", "finance.open_items", "tax.documents", "calculation.artifacts", "automation.command_requests"]
    },
    {
      "id": "sales_return",
