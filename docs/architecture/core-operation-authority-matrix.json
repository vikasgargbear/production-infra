      "mcp_prepare_tool": "erp_sales_return_prepare",
      "rest_context": ["/api/canonical/returns/sales-invoices/{invoice_id}/context"],
      "rest_readback": "/api/canonical/returns/sales/{resource_id}",
      "prepare_sql": "erp_automation_commands.persist_sales_return_prepare",
      "execute_sql": ["erp_commercial_commands.post_sales_return"],
      "authoritative_tables": ["sales.returns", "sales.return_lines", "inventory.inventory_documents", "inventory.inventory_document_lines", "inventory.stock_ledger_entries", "inventory.stock_balances", "finance.adjustment_notes", "finance.adjustment_note_lines", "finance.accounting_events", "finance.journal_entries", "finance.journal_lines", "finance.allocations", "finance.open_items", "tax.documents", "calculation.artifacts", "automation.command_requests"]
    },
    {
      "id": "purchase_order",
      "operation_key": "procurement.purchase_order.prepare",
      "mcp_prepare_tool": "erp_purchase_order_prepare",
      "rest_context": [],
      "rest_readback": "/api/canonical/purchase-orders/{resource_id}",
      "prepare_sql": "erp_automation_commands.persist_purchase_order_prepare",
      "execute_sql": ["erp_trade_commands_v2.approve_purchase_order"],
