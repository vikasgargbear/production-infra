{
  "contract_version": 1,
  "status": "required_unimplemented",
  "owner": "finance-platform",
  "purpose": "durable replay protection for consequential payment mutations",
  "scope_identity": [
    "organization_id",
    "actor_id",
    "operation_id",
    "idempotency_key_hash"
  ],
  "required_fields": [
    "request_hash",
    "processing_state",
    "http_status",
    "response_body",
    "resource_type",
    "resource_id",
    "created_at",
    "completed_at",
    "expires_at"
  ],
  "required_invariants": [
    "scope_identity_is_unique",
    "raw_idempotency_key_is_never_persisted",
    "request_hash_mismatch_is_rejected",
    "claim_and_business_effect_share_one_transaction",
    "completed_response_is_replayed_exactly",
    "in_progress_claim_is_not_executed_twice",
    "organization_scope_is_database_enforced",
    "payment_keys_outlive_client_retry_windows"
  ],
  "required_operations": [
    "payment.create",
    "payment.record",
    "payment.customer_receipt",
    "payment.cancel",
    "payment.reconcile",
    "payment.allocate"
  ],
  "promotion_requirements": [
    "reviewed_live_schema_baseline",
    "approved_alembic_migration",
    "concurrent_claim_integration_test",
    "tenant_isolation_integration_test",
    "request_mismatch_integration_test",
    "atomic_rollback_integration_test"
  ],
  "temporary_backend": "financial.payments.internal_notes",
  "temporary_backend_allowed_environments": [
    "development",
    "test"
  ]
}
