{
  "template_schema": "aasopharma.live18.ui-template.v1",
  "operation_id": "stock_transfer",
  "lifecycle_mode": "combined_actor_confirmation",
  "steps": {
    "missing_required_steps": [
      {"actor":"requester","action":"goto","value":"/#/stock-management/stock-transfer"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Source branch","exact":true},"value":"{{fact.identity.branch_id}}"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Source location","exact":true},"value":"{{fact.identity.saleable_location_id}}"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Destination branch","exact":true},"value":"{{fact.identity.transfer_destination_branch_id}}"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Destination location","exact":true},"value":"{{fact.identity.transfer_destination_location_id}}"},
      {"actor":"requester","action":"fill","locator":{"kind":"placeholder","name":"Search product to transfer…","exact":true},"value":"{{fact.display.product_code}}"},
      {"actor":"requester","action":"click","locator":{"kind":"testId","name":"product-search-option-{{fact.identity.product_id}}"}},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"button","name":"Propose FEFO allocation","exact":true}},
      {"actor":"requester","action":"expectText","locator":{"kind":"text","name":"Requested transfer quantity must be a plain decimal string.","exact":true},"value":"Requested transfer quantity must be a plain decimal string."}
    ],
    "prepare_steps": [
      {"actor":"requester","action":"goto","value":"/#/stock-management/stock-transfer"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Source branch","exact":true},"value":"{{fact.identity.branch_id}}"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Source location","exact":true},"value":"{{fact.identity.saleable_location_id}}"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Destination branch","exact":true},"value":"{{fact.identity.transfer_destination_branch_id}}"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Destination location","exact":true},"value":"{{fact.identity.transfer_destination_location_id}}"},
      {"actor":"requester","action":"fill","locator":{"kind":"label","name":"Planned transfer distance in kilometres","exact":true},"value":"{{scalar.stock_transfer_distance_km}}"},
      {"actor":"requester","action":"fill","locator":{"kind":"placeholder","name":"Search product to transfer…","exact":true},"value":"{{fact.display.product_code}}"},
      {"actor":"requester","action":"click","locator":{"kind":"testId","name":"product-search-option-{{fact.identity.product_id}}"}},
      {"actor":"requester","action":"expectText","locator":{"kind":"testId","name":"transfer-fefo-batch-{{fact.identity.direct_issue_batch_id}}"},"value":"FEFO default"},
      {"actor":"requester","action":"fill","locator":{"kind":"label","name":"Requested transfer quantity for {{fact.display.product_name}}","exact":true},"value":"{{scalar.stock_transfer_quantity}}"},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"button","name":"Propose FEFO allocation","exact":true}},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"button","name":"Add product allocation","exact":true}},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"button","name":"Continue","exact":true}},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"button","name":"Prepare transfer","exact":true}}
    ],
    "approval_steps": [
      {"actor":"requester","action":"expectText","locator":{"kind":"role","role":"dialog","name":"Confirm inter-branch stock transfer","exact":true},"value":"{{command_request_id}}"}
    ],
    "execute_steps": [
      {"actor":"requester","action":"expectText","locator":{"kind":"role","role":"dialog","name":"Confirm inter-branch stock transfer","exact":true},"value":"{{command_request_id}}"},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"button","name":"Approve and post once","exact":true}}
    ]
  }
}
