{
  "template_schema": "aasopharma.live18.ui-template.v1",
  "operation_id": "supplier_payment",
  "lifecycle_mode": "combined_actor_confirmation",
  "steps": {
    "missing_required_steps": [
      {"actor":"requester","action":"goto","value":"/#/payment/supplier-payment"},
      {"actor":"requester","action":"expectText","locator":{"kind":"text","name":"Required: select supplier, branch, bank, method, reference, and at least one exact payable allocation.","exact":true},"value":"Required: select supplier, branch, bank, method, reference, and at least one exact payable allocation."}
    ],
    "prepare_steps": [
      {"actor":"requester","action":"goto","value":"/#/payment/supplier-payment"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Supplier","exact":true},"value":"{{fact.identity.supplier_account_id}}"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Branch","exact":true},"value":"{{fact.identity.branch_id}}"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Bank and settlement ledger","exact":true},"value":"{{fact.identity.bank_account_id}}"},
      {"actor":"requester","action":"select","locator":{"kind":"label","name":"Method","exact":true},"value":"{{scalar.supplier_payment_method}}"},
      {"actor":"requester","action":"fill","locator":{"kind":"label","name":"Bank / UPI reference","exact":true},"value":"LIVE18-SPAY-{{run_token}}"},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"radio","name":"Manual per invoice","exact":true}},
      {"actor":"requester","action":"fill","locator":{"kind":"label","name":"{{resource_supplier_invoice}}","exact":false},"value":"{{scalar.supplier_payment_amount}}"},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"button","name":"Review immutable preview","exact":true}}
    ],
    "approval_steps": [
      {"actor":"requester","action":"expectText","locator":{"kind":"label","name":"Canonical command ID","exact":true},"value":"{{command_request_id}}"},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"checkbox","name":"{{scalar.supplier_payment_posting_attestation}}","exact":true}}
    ],
    "execute_steps": [
      {"actor":"requester","action":"expectText","locator":{"kind":"label","name":"Canonical command ID","exact":true},"value":"{{command_request_id}}"},
      {"actor":"requester","action":"click","locator":{"kind":"role","role":"button","name":"Post ₹{{scalar.supplier_payment_amount}}","exact":true}}
    ]
  }
}
