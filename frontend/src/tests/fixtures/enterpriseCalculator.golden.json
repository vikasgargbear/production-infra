{
  "vectors": [
    {
      "name": "intra-state GST splits equally into CGST and SGST",
      "operation": "calculateTotals",
      "items": [
        { "quantity": 10, "unit_price": 100, "discount_percent": 10, "gst_percent": 18 }
      ],
      "options": { "gst_type": "CGST/SGST", "round_final_amount": false },
      "expectedTotals": {
        "gross_amount": 1000,
        "discount_amount": 100,
        "taxable_amount": 900,
        "tax_amount": 162,
        "cgst_amount": 81,
        "sgst_amount": 81,
        "igst_amount": 0,
        "final_amount": 1062
      }
    },
    {
      "name": "inter-state GST is assigned entirely to IGST",
      "operation": "calculateTotals",
      "items": [
        { "quantity": 10, "unit_price": 100, "discount_percent": 10, "gst_percent": 18 }
      ],
      "options": { "gst_type": "IGST", "round_final_amount": false },
      "expectedTotals": {
        "taxable_amount": 900,
        "tax_amount": 162,
        "cgst_amount": 0,
        "sgst_amount": 0,
        "igst_amount": 162,
        "final_amount": 1062
      }
    },
    {
      "name": "document discount is applied after line discount and before GST",
      "operation": "calculateInvoice",
      "input": {
        "gst_type": "CGST/SGST",
        "discount_type": "percentage",
        "discount_percent": 10,
        "items": [
          { "quantity": 2, "unit_price": 100, "discount_percent": 10, "gst_percent": 18 }
        ]
      },
      "expectedTotals": {
        "gross_amount": 200,
        "discount_amount": 20,
        "scheme_discount": 18,
        "taxable_amount": 162,
        "tax_amount": 29.16,
        "cgst_amount": 14.58,
        "sgst_amount": 14.58,
        "net_amount": 191.16,
        "round_off_amount": -0.16,
        "final_amount": 191
      }
    },
    {
      "name": "free quantity increases physical quantity without increasing taxable value",
      "operation": "calculateTotals",
      "items": [
        { "quantity": 10, "free_quantity": 2, "unit_price": 100, "gst_percent": 5 }
      ],
      "options": { "round_final_amount": false },
      "expectedTotals": {
        "gross_amount": 1000,
        "taxable_amount": 1000,
        "tax_amount": 50,
        "final_amount": 1050
      },
      "expectedFirstItem": {
        "base_quantity": 10,
        "free_quantity": 2,
        "total_quantity": 12,
        "subtotal": 1000
      }
    },
    {
      "name": "sales return caps taxable quantity to the originally paid quantity",
      "operation": "calculateSalesReturn",
      "input": {
        "gst_type": "CGST/SGST",
        "items": [
          {
            "selected": true,
            "return_quantity": 5,
            "paid_quantity": 3,
            "free_quantity": 2,
            "unit_price": 100,
            "gst_percent": 18
          }
        ]
      },
      "expectedTotals": {
        "subtotal": 300,
        "tax_amount": 54,
        "cgst_amount": 27,
        "sgst_amount": 27,
        "total_return_quantity": 5,
        "final_amount": 354
      },
      "expectedFirstItem": {
        "requested_quantity": 5,
        "base_quantity": 3,
        "free_quantity": 2,
        "taxable_amount": 300
      }
    },
    {
      "name": "purchase return preserves the supplier discount and IGST reversal",
      "operation": "calculatePurchaseReturn",
      "input": {
        "gst_type": "IGST",
        "include_gst": true,
        "items": [
          {
            "selected": true,
            "return_quantity": 2,
            "unit_price": 175,
            "discount_percent": 5,
            "gst_percent": 12
          }
        ]
      },
      "expectedTotals": {
        "subtotal": 332.5,
        "tax_amount": 39.9,
        "cgst_amount": 0,
        "sgst_amount": 0,
        "igst_amount": 39.9,
        "round_off_amount": -0.4,
        "total_return_quantity": 2,
        "final_amount": 372
      },
      "expectedFirstItem": {
        "requested_quantity": 2,
        "base_quantity": 2,
        "discount_amount": 17.5,
        "taxable_amount": 332.5,
        "igst_amount": 39.9
      }
    },
    {
      "name": "half rupee rounds upward to the next whole rupee",
      "operation": "calculateTotals",
      "items": [
        { "quantity": 1, "unit_price": 100.5, "gst_percent": 0 }
      ],
      "options": {},
      "expectedTotals": {
        "net_amount": 100.5,
        "round_off_amount": 0.5,
        "final_amount": 101
      }
    }
  ]
}
