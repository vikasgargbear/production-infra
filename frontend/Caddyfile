{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	log {
		format json
	}

	encode zstd gzip

	handle /health {
		header Content-Type "text/plain; charset=utf-8"
		respond "ok" 200
	}

	handle {
		root * /srv
		route {
			# Resolve SPA routes first so even fallback HTML is revalidated.
			try_files {path} /index.html
			header Cache-Control "no-cache, max-age=0, must-revalidate"
			# Only content-addressed build assets may survive a deployment.
			@hashed_asset path_regexp hashed_asset ^/static/(js|css|media)/.+\.[a-f0-9]{8,}\.[A-Za-z0-9.]+$
			header @hashed_asset Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
}
