{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	log {
		format json
	}

	encode zstd gzip

	handle /health {
		header Content-Type "text/plain; charset=utf-8"
		respond "ok" 200
	}

	# Missing build assets are not SPA routes. Never return index.html as JS.
	handle /static/* {
		root * /srv
		route {
			@missing not file {path}
			header @missing Cache-Control "no-store"
			respond @missing "Asset not found" 404
			header Cache-Control "no-cache, max-age=0, must-revalidate"
			@hashed_asset path_regexp hashed_asset ^/static/(js|css|media)/.+\.[a-f0-9]{8,}\.[A-Za-z0-9.]+$
			header @hashed_asset Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}

	handle {
		root * /srv
		route {
			# Only application routes may fall back to revalidated HTML.
			try_files {path} /index.html
			header Cache-Control "no-cache, max-age=0, must-revalidate"
			file_server
		}
	}
}
