{
  "name": "pharma-erp-frontend",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "@headlessui/react": "^2.2.7",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "ajv": "^8.17.1",
    "axios": "^1.6.2",
    "chart.js": "^4.5.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.11.1",
    "idb": "^8.0.3",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.536.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^6.20.0",
    "react-to-print": "^3.1.1",
    "react-toastify": "^11.0.5",
    "recharts": "^3.1.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:critical": "ESLINT_USE_FLAT_CONFIG=false eslint --max-warnings 0 src/contexts/AuthContext.tsx src/contexts/CompanyContext.tsx src/services/enterpriseCalculator.ts 'src/services/auth/**/*.{ts,tsx}' 'src/services/calculations/**/*.{ts,tsx}' src/services/api/apiClient.ts src/services/api/utils/dataUtils.ts 'src/services/api/modules/{sales,purchase,finance}/*Calculations.api.ts'",
    "lint:payment": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/components/payment/**/*.{js,jsx,ts,tsx}\" \"src/utils/financialEntryNotifier.tsx\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint",
    "test": "craco test",
    "test:watch": "craco test --watch",
    "test:ci": "CI=true craco test --watchAll=false",
    "test:coverage": "craco test --coverage",
    "test:modules": "node src/tests/test-runner.js",
    "test:api": "node test-api-endpoints.js",
    "test:components": "CI=true craco test --watchAll=false src/tests/unit",
    "test:integration": "CI=true craco test --watchAll=false src/tests/integration",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:system-chrome": "PLAYWRIGHT_USE_SYSTEM_CHROME=true playwright test --config playwright.config.ts",
    "test:e2e:headed": "playwright test --config playwright.config.ts --headed",
    "test:e2e:live": "playwright test --config playwright.config.ts e2e/live-production-smoke.spec.ts --workers=1",
    "test:e2e:live:headed": "playwright test --config playwright.config.ts e2e/live-production-smoke.spec.ts --headed --workers=1",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:all": "npm run test:ci && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "chalk": "^5.4.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest-watch-typeahead": "^3.0.1",
    "prettier": "^3.1.0",
    "react-scripts": "5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
